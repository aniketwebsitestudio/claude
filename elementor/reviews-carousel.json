          "settings": {
            "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700&display=swap');\n\n#sneh-rev{\n  --ink:#0B211F; --ink-2:#153733; --ink-3:#1D4A45;\n  --teal-lt:#489a8f; --coral:#f49b7b;\n  --d1:#F2F4F1; --d2:rgba(242,244,241,.66); --d3:rgba(242,244,241,.40);\n  --line-d:rgba(242,244,241,.13);\n  --serif:\"Fraunces\",Georgia,serif;\n  --sans:\"DM Sans\",-apple-system,\"Segoe UI\",sans-serif;\n  --pad:clamp(20px,5vw,72px);\n  --sec:clamp(72px,11vh,150px);\n  --ease:cubic-bezier(.16,1,.3,1);\n\n  background:var(--ink-2); color:var(--d1);\n  font-family:var(--sans); font-weight:300; line-height:1.6;\n  padding:var(--sec) 0; margin:0; overflow:hidden;\n  -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;\n}\n#sneh-rev *,#sneh-rev *::before,#sneh-rev *::after{box-sizing:border-box}\n#sneh-rev div,#sneh-rev p,#sneh-rev blockquote,#sneh-rev span,#sneh-rev i{\n  margin:0; padding:0; border:0; background:none; quotes:none;\n  font-style:normal; text-transform:none; letter-spacing:normal; text-align:left}\n#sneh-rev blockquote::before,#sneh-rev blockquote::after{content:none}\n#sneh-rev ::selection{background:var(--coral);color:#3A1B0C}\n\n/* ---------- reveal primitives ---------- */\n#sneh-rev .rv{overflow:hidden;display:block}\n#sneh-rev .rv > span{display:block}\n#sneh-rev.js .fade{opacity:0}\n\n/* ---------- top block ---------- */\n#sneh-rev .top{padding:0 var(--pad);max-width:1180px;margin:0 auto;\n  display:flex;gap:clamp(28px,5vw,72px);align-items:flex-start;flex-wrap:wrap}\n#sneh-rev .score{flex:0 0 auto}\n#sneh-rev .score .n{font-family:var(--serif);font-weight:300;font-size:clamp(64px,10vw,140px);\n  line-height:.85;letter-spacing:-.04em;font-variant-numeric:tabular-nums;color:var(--d1)}\n#sneh-rev .score .st{color:var(--coral);letter-spacing:.22em;font-size:14px;margin-top:14px}\n#sneh-rev .score .k{font-size:10px;letter-spacing:.18em;text-transform:uppercase;\n  color:var(--d3);margin-top:10px}\n#sneh-rev .lead{flex:1 1 380px;min-width:0}\n#sneh-rev .eyebrow{font-size:10px;letter-spacing:.26em;text-transform:uppercase;\n  font-weight:500;color:var(--d3);line-height:1.6}\n#sneh-rev blockquote{font-family:var(--serif);font-weight:300;font-size:clamp(19px,2.3vw,31px);\n  line-height:1.34;letter-spacing:-.02em;max-width:24ch;margin-top:20px;color:var(--d1)}\n#sneh-rev .lede{font-size:clamp(15px,1.15vw,17px);line-height:1.72;color:var(--d2);\n  max-width:52ch;font-weight:300;margin-top:20px}\n#sneh-rev .who{margin-top:20px;font-size:11px;letter-spacing:.16em;\n  text-transform:uppercase;color:var(--d3)}\n\n/* ---------- marquee ---------- */\n#sneh-rev .mq{margin-top:clamp(44px,7vh,84px);overflow:hidden;position:relative;\n  -webkit-mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);\n          mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent)}\n#sneh-rev .mqin{display:flex;gap:14px;width:max-content;will-change:transform}\n#sneh-rev .q{width:clamp(250px,25vw,330px);border:1px solid var(--line-d);border-radius:3px;\n  padding:24px;flex:0 0 auto}\n#sneh-rev .q p{font-size:13px;line-height:1.68;color:var(--d2)}\n#sneh-rev .q .a{margin-top:16px;font-size:10px;letter-spacing:.16em;\n  text-transform:uppercase;color:var(--d3)}\n#sneh-rev .q .a i{color:var(--coral);font-style:normal}\n\n/* ---------- responsive ---------- */\n@media(max-width:767px){\n  #sneh-rev .top{gap:26px}\n  #sneh-rev .score .st{font-size:13px;letter-spacing:.18em}\n  #sneh-rev blockquote{max-width:100%}\n  #sneh-rev .q{padding:20px;width:clamp(230px,72vw,300px)}\n  #sneh-rev .mq{-webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);\n                        mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}\n}\n@media(prefers-reduced-motion:reduce){\n  #sneh-rev.js .fade{opacity:1}\n  /* no auto-scroll — swipe the row instead */\n  #sneh-rev .mq{overflow-x:auto;-webkit-overflow-scrolling:touch}\n  #sneh-rev .mqin{width:auto}\n  #sneh-rev *{transition-duration:.01ms!important}\n}\n</style>\n\n<section id=\"sneh-rev\">\n  <div class=\"top\">\n    <div class=\"score fade\">\n      <div class=\"n\" data-count=\"4.3\">4.3</div>\n      <div class=\"st\">&#9733;&#9733;&#9733;&#9733;&#9734;</div>\n      <div class=\"k\">4,396 guest ratings</div>\n    </div>\n    <div class=\"lead\">\n      <div class=\"eyebrow fade\">Guest stories</div>\n      <blockquote class=\"sneh-lines\">The food was so, so tasty.</blockquote>\n      <p class=\"lede fade\">&ldquo;Best place to hang out for couples as well as friends &mdash; mirror maze, flying chair, magic show, swimming pool and rain dance.&rdquo;</p>\n      <div class=\"who fade\">Umila Shinde &middot; day-out package guest</div>\n    </div>\n  </div>\n\n  <div class=\"mq\">\n    <div class=\"mqin\">\n      <div class=\"q\"><p>Kids didn&rsquo;t want to leave. The rain dance ran till closing and the staff kept it going.</p><div class=\"a\"><i>&#9733;&#9733;&#9733;&#9733;&#9733;</i> &middot; Neha S., Pune</div></div>\n      <div class=\"q\"><p>Booked the lawn for 300 people. Setup was handled without a single call from our side.</p><div class=\"a\"><i>&#9733;&#9733;&#9733;&#9733;&#9733;</i> &middot; Rohit M., wedding</div></div>\n      <div class=\"q\"><p>Tent stay facing the dam. Woke up to mist on the water &mdash; worth it for that alone.</p><div class=\"a\"><i>&#9733;&#9733;&#9733;&#9733;&#9734;</i> &middot; Aditi K., staycation</div></div>\n      <div class=\"q\"><p>Company offsite for 45. Conference room in the morning, bull ride by 4 PM.</p><div class=\"a\"><i>&#9733;&#9733;&#9733;&#9733;&#9733;</i> &middot; Sameer D., corporate</div></div>\n      <div class=\"q\"><p>Good value for a full day out. The buffet was better than we expected.</p><div class=\"a\"><i>&#9733;&#9733;&#9733;&#9733;&#9734;</i> &middot; Prasad J., day picnic</div></div>\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  var EASE  = 'cubic-bezier(.16,1,.3,1)';\n  var CYCLE = 38;    /* seconds for one full loop, same as the source */\n  var SLOW  = 0.25;  /* speed multiplier while hovered */\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  var el = document.getElementById('sneh-rev');\n  if(!el || el.dataset.snehReady === '1') return;\n  el.dataset.snehReady = '1';\n  el.className = 'js';   /* set before paint so .fade can start hidden */\n\n  function expoOut(t){ return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); }\n\n  /* ---------------- reveals ---------------------------------------------- */\n  /* masked line reveal, split on <br> like the source's lineSplit() */\n  var lines = [];\n  Array.prototype.forEach.call(el.querySelectorAll('.sneh-lines'), function(h){\n    h.innerHTML = h.innerHTML.split(/<br\\s*\\/?>/i).map(function(p){\n      return '<span class=\"rv\"><span>' + p + '</span></span>';\n    }).join('');\n    Array.prototype.forEach.call(h.querySelectorAll('.rv > span'), function(s,i){\n      if(!reduce){\n        s.style.transform  = 'translateY(118%)';\n        s.style.transition = 'transform 1.25s ' + EASE + ' ' + (i * .09) + 's';\n      }\n      lines.push(s);\n    });\n    h.dataset.snehLines = '1';\n  });\n\n  var fades = Array.prototype.slice.call(el.querySelectorAll('.fade'));\n  if(!reduce){\n    fades.forEach(function(f){\n      f.style.transform  = 'translateY(22px)';\n      f.style.transition = 'opacity .9s ' + EASE + ',transform .9s ' + EASE;\n    });\n  }\n\n  function show(node){\n    node.style.opacity = 1;\n    node.style.transform = 'none';\n    Array.prototype.forEach.call(node.querySelectorAll('.rv > span'), function(s){\n      s.style.transform = 'none';\n    });\n    if(node.querySelector('[data-count]') || node.hasAttribute('data-count')) countUp(node);\n  }\n\n  /* ---------------- count-up: 0 -> 4.3 over 1.6s, expo.out ---------------- */\n  function countUp(scope){\n    var nodes = scope.hasAttribute('data-count') ? [scope]\n              : Array.prototype.slice.call(scope.querySelectorAll('[data-count]'));\n    nodes.forEach(function(n){\n      if(n.dataset.snehCounted === '1') return;\n      n.dataset.snehCounted = '1';\n      var target = parseFloat(n.dataset.count);\n      var dec    = target % 1 !== 0;\n      var comma  = n.dataset.fmt === 'comma';\n      if(reduce) return;\n      var t0 = null;\n      (function step(now){\n        if(t0 === null) t0 = now;\n        var p = Math.min((now - t0) / 1600, 1);\n        var v = target * expoOut(p);\n        var s = dec ? v.toFixed(1) : String(Math.round(v));\n        n.textContent = comma ? Number(s).toLocaleString('en-IN') : s;\n        if(p < 1) window.requestAnimationFrame(step);\n      })(performance.now());\n    });\n  }\n\n  var targets = fades.concat(\n    Array.prototype.slice.call(el.querySelectorAll('[data-sneh-lines=\"1\"],.sneh-lines')));\n\n  if(reduce || !('IntersectionObserver' in window)){\n    targets.forEach(show);\n  } else {\n    var io = new IntersectionObserver(function(entries){\n      entries.forEach(function(e){\n        if(e.isIntersecting){ show(e.target); io.unobserve(e.target); }\n      });\n    }, {rootMargin:'0px 0px -10% 0px', threshold:0.01});\n    targets.forEach(function(t){ io.observe(t); });\n  }\n\n  /* ---------------- infinite marquee -------------------------------------\n     Duplicated track translated by rAF. Not CSS keyframes: the loop distance\n     depends on measured card widths, which change with the viewport, and not\n     GSAP either so the block has no external dependency.                   */\n  var mq   = el.querySelector('.mq');\n  var mqin = el.querySelector('.mqin');\n  if(!mq || !mqin || reduce) return;\n\n  /* second copy for the seamless wrap, hidden from screen readers */\n  Array.prototype.forEach.call(Array.prototype.slice.call(mqin.children), function(card){\n    var clone = card.cloneNode(true);\n    clone.setAttribute('aria-hidden', 'true');\n    mqin.appendChild(clone);\n  });\n\n  var half = 0, x = 0, factor = 1, target = 1, last = 0;\n  var raf = null, running = false, inView = false;\n\n  function measure(){\n    var w = mqin.scrollWidth / 2;\n    if(w && w !== half){\n      half = w;\n      if(x <= -half) x = x % half;\n    }\n  }\n\n  function frame(now){\n    if(!running) return;\n    var dt = last ? Math.min((now - last) / 1000, .05) : 0;   /* clamp tab-switch jumps */\n    last = now;\n    factor += (target - factor) * Math.min(dt * 6, 1);        /* ease the speed change */\n    x -= (half / CYCLE) * factor * dt;\n    if(x <= -half) x += half;\n    mqin.style.transform = 'translate3d(' + x.toFixed(2) + 'px,0,0)';\n    raf = window.requestAnimationFrame(frame);\n  }\n\n  function start(){ if(running) return; running = true; last = 0; raf = window.requestAnimationFrame(frame); }\n  function stop(){ running = false; if(raf) window.cancelAnimationFrame(raf); raf = null; }\n\n  measure();\n  window.addEventListener('resize', measure, {passive:true});\n  if(document.fonts && document.fonts.ready) document.fonts.ready.then(measure);\n  window.addEventListener('load', measure);\n\n  mq.addEventListener('mouseenter', function(){ target = SLOW; });\n  mq.addEventListener('mouseleave', function(){ target = 1; });\n  mq.addEventListener('touchstart', function(){ target = SLOW; }, {passive:true});\n  mq.addEventListener('touchend',   function(){ target = 1; },    {passive:true});\n\n  /* only animate while it's on screen, and pause on a hidden tab */\n  function refresh(){\n    if(inView && !document.hidden) start(); else stop();\n  }\n  if('IntersectionObserver' in window){\n    new IntersectionObserver(function(entries){\n      inView = entries[0].isIntersecting;\n      refresh();\n    }, {rootMargin:'200px 0px'}).observe(mq);\n  } else { inView = true; refresh(); }\n\n  document.addEventListener('visibilitychange', refresh);\n})();\n</script>\n"
          },
          "elements": []
        }
      ],
      "isInner": false
    }
