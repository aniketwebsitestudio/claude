    "custom_our_values_1": {
      "type": "custom-our-values",
      "blocks": {
        "col_1": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/image_28.png",
            "title": "Made to Mean Something",
            "text": "<p>What you bring home from Bhoomija will outlast the occasion you bought it for. That is the intention, and that is the promise.</p>",
            "text_first": false,
            "offset": 0
          }
        },
        "col_2": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/image_27.png",
            "title": "Craft First",
            "text": "<p>We begin where the maker begins, with material and method. Not with margin.</p>",
            "text_first": true,
            "offset": 0
          }
        },
        "col_3": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/image_29.png",
            "title": "Rooted in Relationship",
            "text": "<p>Our artisans are not vendors. They are the reason Bhoomija exists. Every collection starts with a conversation, not a brief.</p>",
            "text_first": false,
            "offset": 0
          }
        }
      },
      "block_order": [
        "col_1",
        "col_2",
        "col_3"
      ],
      "name": "Our Values",
      "settings": {
        "eyebrow": "Our Values",
        "heading": "The clay that <br> we are made of",
