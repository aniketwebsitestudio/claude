<section class="our-values" {% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}>
	{%- if section.settings.eyebrow != blank -%}
	<div class="our-values__eyebrow">
		{{ section.settings.eyebrow | escape }}
	</div>
	{%- endif -%}

	{%- if section.settings.heading != blank -%}
	<div class="our-values__heading">{{ section.settings.heading }}</div>
	{%- endif -%}

	{%- if section.settings.tagline != blank -%}
	<div class="our-values__tagline">{{ section.settings.tagline }}</div>
	{%- endif -%}

	<div class="our-values__grid">
		{%- for block in section.blocks -%}
		{%- case block.type -%}
		{%- when 'column' -%}
		<div class="our-values__column our-values__column--{{ block.settings.position }}">
			{%- if block.settings.image != blank -%}
			<img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.image.alt }}" class="our-values__image" loading="lazy">
			{%- endif -%}

			{%- if block.settings.title != blank -%}
			<h3 class="our-values__title">{{ block.settings.title | escape }}</h3>
			{%- endif -%}

			{%- if block.settings.text != blank -%}
			<p class="our-values__text">{{ block.settings.text | escape }}</p>
			{%- endif -%}
		</div>
		{%- endcase -%}
		{%- endfor -%}
	</div>
</section>

{% schema %}
{
	"name": "Our Values",
	"disabled_on": { "groups": ["header", "footer", "aside"] },
	"settings": [
		{
			"type": "text",
			"id": "eyebrow",
			"label": "Eyebrow label",
			"default": "Our Values"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Crafted with Purpose"
		},
		{
			"type": "richtext",
			"id": "tagline",
			"label": "Tagline",
			"default": "<em>Every detail matters</em>"
		},
		{
			"type": "header",
			"content": "Appearance"
		},
		{
			"type": "checkbox",
			"id": "global_color_scheme",
			"label": "Use global color scheme",
			"default": true
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "coretex-1",
			"visible_if": "{{ section.settings.global_color_scheme == false }}"
		}
	],
	"blocks": [
		{
			"type": "column",
			"name": "Value Column",
			"settings": [
				{
					"type": "select",
					"id": "position",
					"label": "Column Position",
					"options": [
						{ "label": "Left", "value": "left" },
						{ "label": "Center", "value": "center" },
						{ "label": "Right", "value": "right" }
					],
					"default": "left"
				},
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				},
				{
					"type": "text",
					"id": "title",
					"label": "Title",
					"default": "Quality"
				},
				{
					"type": "textarea",
					"id": "text",
					"label": "Description",
					"default": "Handcrafted with attention to every detail."
				}
			]
		}
	],
	"presets": [
		{
			"name": "Our Values",
			"category": "Content",
			"blocks": [
				{ "type": "column", "settings": { "position": "left", "title": "Authenticity", "text": "True to our roots." } },
				{ "type": "column", "settings": { "position": "center", "title": "Excellence", "text": "No compromises." } },
				{ "type": "column", "settings": { "position": "right", "title": "Sustainability", "text": "Built to last." } }
			]
		}
	]
}
{% endschema %}
