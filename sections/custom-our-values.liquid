{%- render 'inc-stylesheet', src: 's-sections.css' -%}

<section class="our-values" id="ov-{{ section.id }}" style="--accent:{{ section.settings.accent }}" {% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}>
	{%- if section.settings.eyebrow != blank -%}
	<div class="our-values__eyebrow"><span>{{ section.settings.eyebrow | escape }}</span></div>
	{%- endif -%}

	{%- if section.settings.heading != blank -%}
	<h2 class="our-values__heading">{{ section.settings.heading }}</h2>
	{%- endif -%}

	<div class="our-values__grid">
		{%- for block in section.blocks -%}
		<div class="our-values__col {% if block.settings.text_first %}is-text-first{% endif %}" style="--colOffset:{{ block.settings.offset }}px" {{ block.shopify_attributes }}>
			{%- if block.settings.title != blank or block.settings.text != blank -%}
			<div class="our-values__text">
				{%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
				{%- if block.settings.text != blank -%}{{ block.settings.text }}{%- endif -%}
			</div>
			{%- endif -%}
			<div class="our-values__media">
				{%- liquid
					assign img = block.settings.image
					assign widths = '330,480,660,900'
					assign sizes = '(max-width:777px) 88vw, 23vw'
					render 'inc-img', img: img, widths: widths, sizes: sizes, fallback: true
				-%}
			</div>
		</div>
		{%- endfor -%}
	</div>

	{%- if section.settings.tagline != blank -%}
	<p class="our-values__tagline">{{ section.settings.tagline }}</p>
	{%- endif -%}
</section>

{%- if section.settings.enable_animation -%}
<script>
(function () {
	var s = document.getElementById('ov-{{ section.id }}');
	if (!s) return;
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

	{%- if section.settings.scroll_scrub %}
	/* ============ SCRUB MODE: GSAP + ScrollTrigger, tied to mouse scroll ============ */
	s.classList.add('ov-anim', 'ov-gsap');

	function loadScript(src) {
		return new Promise(function (res, rej) {
			var t = document.createElement('script');
			t.src = src; t.onload = res; t.onerror = rej;
			document.head.appendChild(t);
		});
	}

	function init() {
		gsap.registerPlugin(ScrollTrigger);
		var grid = s.querySelector('.our-values__grid') || s;
		var cols = s.querySelectorAll('.our-values__col');

		cols.forEach(function (col) {
			var offset = parseFloat(getComputedStyle(col).getPropertyValue('--colOffset')) || 0;
			var isTextFirst = col.classList.contains('is-text-first');
			/* text-first (middle) rises from below; others drop from above.
			   Start position includes the editor offset so it travels from the
			   staggered layout into the final aligned grid. */
			var fromY = isTextFirst ? offset + 90 : -(64 + offset * 0.4);

			gsap.fromTo(col,
				{ y: fromY, autoAlpha: 0.15 },
				{
					y: 0, autoAlpha: 1, ease: 'none',
					scrollTrigger: {
						trigger: grid,
						start: 'top 88%',
						end: 'top 30%',
						scrub: 0.8
					}
				}
			);
		});
	}

	var ready = (window.gsap && window.ScrollTrigger)
		? Promise.resolve()
		: loadScript('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js')
			.then(function () { return loadScript('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js'); });

	ready.then(init).catch(function () {
		/* CDN failed: just show the section aligned, no animation */
		s.classList.remove('ov-anim', 'ov-gsap');
	});

	{%- else %}
	/* ============ ONE-TIME MODE: IntersectionObserver, plays once ============ */
	if (!('IntersectionObserver' in window)) return;
	s.classList.add('ov-anim');
	var target = s.querySelector('.our-values__grid') || s;
	var io = new IntersectionObserver(function (entries) {
		entries.forEach(function (e) {
			if (e.isIntersecting) {
				s.classList.add('ov-inview');
				io.disconnect();
			}
		});
	}, { threshold: 0, rootMargin: '0px 0px -35% 0px' });
	io.observe(target);
	{%- endif %}
})();
</script>
{%- endif -%}

<style>
	.our-values { border-block-end: var(--globalBorder) }

	.our-values__eyebrow {
		text-align: center;
		padding: var(--space-2) var(--mardding);
		border-block-end: var(--globalBorder);
		text-transform: uppercase;
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}

	/* Heading: theme heading font (IvyPresto Display via --hFontFamily), centered, two lines */
	.our-values__heading {
		font-family: var(--hFontFamily, serif);
		font-weight: 100;
		text-align: center;
		font-size: clamp(2.4rem, 5.28vw, 76px);
		line-height: 1.06;
		margin: clamp(2.5rem, 5vw, 72px) auto clamp(2rem, 4vw, 56px);
		padding-inline: var(--padding);
		text-transform:none!important;
	}

	/* 3 columns, tops aligned in one line */
	.our-values__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		column-gap: clamp(2rem, 7.3vw, 105px);
		row-gap: 3rem;
		align-items: center;
		max-width: 1440px;
		margin-inline: auto;
		padding-inline: clamp(1.25rem, 8.3vw, 120px);
	}

	.our-values__col {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 3.2vw, 46px);
		margin-top: var(--colOffset, 0px);
	}

	/* Text below image by default; above when "text first" (bigger gap pushes its image lower, per design) */
	.our-values__col .our-values__media { order: 1 }
	.our-values__col .our-values__text { order: 2 }
	.our-values__col.is-text-first .our-values__text { order: 1 }
	.our-values__col.is-text-first .our-values__media { order: 2 }
	.our-values__col.is-text-first { gap: clamp(2.5rem, 6.25vw, 90px) }

	.our-values__media picture { display: block }
	.our-values__media img,
	.our-values__media svg {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
	}

	/* Column text: IBM Plex Sans 16px / 150%, brand red */
	.our-values__text {
		color: var(--accent, #7F1416);
		font-size: 16px;
		line-height: 1.5;
	}
	.our-values__text h3 {
		font-size: 16px;
		font-weight: 600;
		line-height: 1.5;
		color: var(--accent, #7F1416);
		margin: 0;
		text-transform: none;
		font-family: "IBM Plex Sans", var(--fontFamily), sans-serif;
	}
	.our-values__text p { margin: 0 }

	/* Tagline: IvyPresto 54px / 110% / 2%, brand red */
	.our-values__tagline {
		font-family: var(--hFontFamily, serif);
		font-weight: 100;
		color: var(--accent, #7F1416);
		text-align: center;
		font-size: clamp(1.6rem, 3.75vw, 54px);
		line-height: 1.1;
		letter-spacing: 0.02em;
		margin: clamp(3rem, 6.25vw, 90px) auto clamp(2.5rem, 4.5vw, 64px);
		padding-inline: var(--padding);
	}

	/* When animation is on, the FINAL state is fully aligned:
	   tops on one line, editor offsets are used only as the travel distance. */
	.our-values.ov-anim .our-values__grid { align-items: start }
	.our-values.ov-anim .our-values__col { margin-top: 0 }

	/* One-time mode (no GSAP): CSS transition, staggered -> aligned, plays once */
	.our-values.ov-anim:not(.ov-gsap) .our-values__col {
		opacity: 0;
		transform: translateY(calc(-64px - var(--colOffset, 0px) * 0.4));
		transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
	}
	.our-values.ov-anim:not(.ov-gsap) .our-values__col.is-text-first {
		transform: translateY(calc(90px + var(--colOffset, 0px)));
		transition-delay: 0.08s;
	}
	.our-values.ov-anim:not(.ov-gsap).ov-inview .our-values__col {
		opacity: 1;
		transform: translateY(0);
	}

	/* Mobile: tighter rhythm, shorter 4/5 images, scaled type. Desktop untouched. */
	@media (max-width: 777px) {
		.our-values__heading {
			font-size: clamp(2.1rem, 9.5vw, 2.6rem);
			margin: 2rem auto 1.75rem;
			padding-inline: var(--mardding, 20px);
		}
		.our-values__grid {
			grid-template-columns: 1fr;
			row-gap: 2.75rem;
			padding-inline: var(--mardding, 20px);
		}
		.our-values__col { margin-top: 0; gap: 1.25rem }
		.our-values__col.is-text-first .our-values__text { order: 2 }
		.our-values__col.is-text-first .our-values__media { order: 1 }
		.our-values__col.is-text-first { gap: 1.25rem }
		.our-values__media img,
		.our-values__media svg { aspect-ratio: 4 / 5 }
		.our-values__text { font-size: 15px }
		.our-values__tagline {
			font-size: clamp(1.5rem, 6.8vw, 1.9rem);
			margin: 2.75rem auto;
			padding-inline: var(--mardding, 20px);
		}
		.our-values.ov-anim:not(.ov-gsap) .our-values__col { transform: translateY(32px) }
	}
</style>

{% schema %}
{
	"name": "Our Values",
	"disabled_on": { "groups": ["header", "footer", "aside"] },
	"settings": [
		{
			"type": "text",
			"id": "eyebrow",
			"label": "Eyebrow label",
			"default": "Our Values"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"info": "Basic HTML like <br> and <em> is supported.",
			"default": "The clay that<br>we are made of"
		},
		{
			"type": "text",
			"id": "tagline",
			"label": "Tagline",
			"info": "Shown below the columns. Basic HTML supported.",
			"default": "Bhoomija, born from the earth. <em>Made by hand.</em>"
		},
		{
			"type": "color",
			"id": "accent",
			"label": "Text accent color",
			"default": "#7F1416"
		},
		{
			"type": "header",
			"content": "Animation"
		},
		{
			"type": "checkbox",
			"id": "enable_animation",
			"label": "Animate on scroll",
			"info": "Side columns slide in from the top, middle column from the bottom. Respects reduced-motion preferences.",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "scroll_scrub",
			"label": "Control with mouse scroll (GSAP ScrollTrigger)",
			"info": "ON: animation scrubs forward/backward with scroll. OFF: animation plays once when the section enters view.",
			"default": false,
			"visible_if": "{{ section.settings.enable_animation }}"
		},
		{
			"type": "header",
			"content": "Appearance"
		},
		{
			"type": "checkbox",
			"id": "global_color_scheme",
			"label": "Use global color scheme",
			"default": true
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "coretex-1",
			"visible_if": "{{ section.settings.global_color_scheme == false }}"
		}
	],
	"blocks": [
		{
			"type": "column",
			"name": "Column",
			"limit": 3,
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				},
				{
					"type": "text",
					"id": "title",
					"label": "Title",
					"default": "Title"
				},
				{
					"type": "richtext",
					"id": "text",
					"label": "Text",
					"default": "<p>Describe this value.</p>"
				},
				{
					"type": "checkbox",
					"id": "text_first",
					"label": "Show text above image",
					"info": "This column also animates in from the bottom instead of the top.",
					"default": false
				},
				{
					"type": "range",
					"id": "offset",
					"label": "Vertical offset - desktop",
					"info": "Animation OFF: pushes this column down (staggered layout). Animation ON: used as the travel distance — column starts staggered, ends aligned.",
					"min": 0,
					"max": 200,
					"step": 4,
					"unit": "px",
					"default": 0
				}
			]
		}
	],
	"presets": [
		{
			"name": "Our Values",
			"category": "Content",
			"blocks": [
				{ "type": "column" },
				{ "type": "column", "settings": { "text_first": true } },
				{ "type": "column" }
			]
		}
	]
}
{% endschema %}
