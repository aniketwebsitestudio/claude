<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% render 'inc-dir' %}" class="no-js">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

    {%- render 'global-meta' -%}
    <script>document.documentElement.className = 'js';</script>

    {%- # Preload assets -%}
    {%- render 'global-preload' -%}

    {%- comment -%}
        Favicon, dark-mode aware.
        The light mark comes from the theme setting when one is picked
        (Theme settings > Favicon); the white mark is used whenever the
        browser reports a dark colour scheme. CSS cannot do this: the
        `media` attribute on <link rel="icon"> works in Safari and Firefox
        but is ignored by Chrome, so the swap is done with matchMedia,
        which every current browser honours.
    {%- endcomment -%}
    {%- liquid
        if settings.favicon != blank
            assign faviconLight = settings.favicon | image_url: width: 180, height: 180
        else
            assign faviconLight = 'https://cdn.shopify.com/s/files/1/0774/6987/6271/files/Black_Bhoomija_Mark.png?v=1785259520'
        endif
        assign faviconDark = 'https://cdn.shopify.com/s/files/1/0774/6987/6271/files/White_Bhoomija_Mark.png?v=1785259520'
    -%}
    <link id="faviconLink" rel="icon" type="image/png" href="{{ faviconLight }}">
    <link rel="apple-touch-icon-precomposed" href="{{ faviconLight }}">
    <script>(() => { const light = {{ faviconLight | json }}, dark = {{ faviconDark | json }}; const link = document.getElementById('faviconLink'); const mq = window.matchMedia('(prefers-color-scheme: dark)'); const paint = () => { link.href = mq.matches ? dark : light; }; paint(); mq.addEventListener ? mq.addEventListener('change', paint) : mq.addListener(paint); })();</script>

    <!-- BEGIN content_for_header -->
    {{ content_for_header }}
    <!-- END content_for_header -->

    {%- liquid
        echo 'skelet.css' | asset_url | stylesheet_tag: preload: true

        render 'global-css'

        if settings.useCustomFont
            render 'global-fonts'
        endif 

        echo 'app.css' | asset_url | stylesheet_tag
    -%}

    {%- # theme-check-disable -%}
    {%- if settings.css != blank -%}<style id="bUserCSS">{{ settings.css }}</style>{%- endif -%}
    {%- # theme-check-enable -%}

    <!-- ADDITIONAL CODE INJECTED BY SHOPIFY -->
    {% # Shopify injects tracking + other code here before the closing of the head tag. %}
    {{ 'custom.css' | asset_url | stylesheet_tag }}
    {{ 'custom-dark.css' | asset_url | stylesheet_tag }}
    {{ 'custom-header.css' | asset_url | stylesheet_tag }}
    {{ 'custom-footer.css' | asset_url | stylesheet_tag }}
</head>
<body 
    class="{{ settings.a11yFocusStyles }}" 
    layout-boxed="{{ settings.boxedLayout }}" 
    coretex-page="{{ template.name }}"
    coretex-path="{{ request.path }}"
>
    <a href="#mainContent" class="skip-to-content button is-primary visually-hidden">{{ "general.accessibility.skip_to_text" | t }}</a>
    <component-loader id="app">
        {%- sections 'group-header' -%}
        <main id="mainContent">
            {%- render 'global-breadcrumbs' -%}
            {{ content_for_layout }}
        </main>
        {%- liquid
            sections 'group-footer'
            sections 'group-overlay'
        -%}
    </component-loader>

    {%- liquid
        # Loading the Language dialog
        if localization.available_languages.size > 1
            render 'global-localization', type: 'language'
        endif 

        # Loading the Country/region dialog
        if localization.available_countries.size > 1
            render 'global-localization', type: 'country'
        endif

        render 'global-js'
    -%}

    <script src="{{ 'custom-coming-soon.js' | asset_url }}" defer></script>

</body>
</html>