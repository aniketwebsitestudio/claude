{%- liquid
	assign cols = section.settings.columns_desktop
	assign cols_m = section.settings.columns_mobile

	assign vw = 100 | divided_by: cols
	assign vw_m = 100 | divided_by: cols_m
	capture sizes
		echo '(min-width: 778px) ' | append: vw | append: 'vw, ' | append: vw_m | append: 'vw'
	endcapture

	comment
		Peek: fraction of the next card visible at the right edge.
		Only applies when there are more cards than visible columns;
		otherwise the cards fill the row and the end padding is restored.
	endcomment
	assign peek_d = section.settings.peek | times: 1.0 | divided_by: 100
	assign haspeek_d = 1
	assign pad_end_d = '0px'
	if section.blocks.size <= cols
		assign peek_d = 0
		assign haspeek_d = 0
		assign pad_end_d = '76px'
	elsif peek_d == 0
		assign haspeek_d = 0
	endif

	assign peek_m = section.settings.peek_mobile | times: 1.0 | divided_by: 100
	assign haspeek_m = 1
	assign pad_end_m = '0px'
	if section.blocks.size <= cols_m
		assign peek_m = 0
		assign haspeek_m = 0
		assign pad_end_m = '20px'
	elsif peek_m == 0
		assign haspeek_m = 0
	endif
-%}

<section
	class="shop-by-category"
	style="
		--sbc-cols: {{ cols }};
		--sbc-cols-m: {{ cols_m }};
		--sbc-gap: {{ section.settings.gap_desktop }}px;
		--sbc-gap-m: {{ section.settings.gap_mobile }}px;
		--sbc-peek: {{ peek_d }};
		--sbc-haspeek: {{ haspeek_d }};
		--sbc-peek-m: {{ peek_m }};
		--sbc-haspeek-m: {{ haspeek_m }};
		--sbc-pe: {{ pad_end_d }};
		--sbc-pe-m: {{ pad_end_m }};
		--sbc-ratio: {{ section.settings.image_ratio }};
		--sbc-heading-size: {{ section.settings.heading_size }}px;
		--sbc-heading-size-m: {{ section.settings.heading_size_mobile }}px;
		--sbc-label-size: {{ section.settings.label_size }}px;
		--sbc-label-size-m: {{ section.settings.label_size_mobile }}px;
		--sbc-pt: {{ section.settings.padding_top }}px;
		--sbc-pb: {{ section.settings.padding_bottom }}px;
		--sbc-pt-m: {{ section.settings.padding_top_mobile }}px;
		--sbc-pb-m: {{ section.settings.padding_bottom_mobile }}px;
	"
>
	{%- if section.settings.heading != blank -%}
		<h2 class="sbc-heading">{{ section.settings.heading }}</h2>
	{%- endif -%}

	<div class="sbc-stage">
		<div class="sbc-viewport">
			<sbc-slider class="sbc-track{% if section.settings.uppercase_labels %} sbc-uppercase{% endif %}" data-loop="{{ section.settings.infinite_loop }}">
				{%- for block in section.blocks -%}
					{%- liquid
						assign c = block.settings.collection

						assign display_image = null
						if block.settings.image
							assign display_image = block.settings.image
						elsif c.image
							assign display_image = c.image
						elsif c.featured_image
							assign display_image = c.featured_image
						endif

						if block.settings.title != blank
							assign display_title = block.settings.title
						elsif c != blank
							assign display_title = c.title
						else
							assign display_title = 'collection.collection' | t
						endif
					-%}
					<div class="sbc-item" {{ block.shopify_attributes }}>
						<a class="sbc-card" {% if c != blank %}href="{{ c.url }}"{% endif %}>
							<div class="sbc-media">
								{%- if display_image -%}
									{{ display_image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: sizes, class: 'sbc-img', loading: 'lazy', alt: display_title }}
								{%- else -%}
									{{ 'collection-1' | placeholder_svg_tag: 'sbc-img sbc-placeholder' }}
								{%- endif -%}
							</div>
							<span class="sbc-label">{{ display_title }}</span>
						</a>
					</div>
				{%- endfor -%}
			</sbc-slider>
		</div>

		{%- if section.settings.show_arrows -%}
		<button type="button" class="sbc-arrow sbc-prev" aria-label="{{ 'pagination.previous' | t }}">
			{%- render 'global-icon' with 'arrow-left' -%}
		</button>
		<button type="button" class="sbc-arrow sbc-next" aria-label="{{ 'pagination.next' | t }}">
			{%- render 'global-icon' with 'arrow-right' -%}
		</button>
		{%- endif -%}
	</div>

	{%- if section.settings.show_dots -%}
	<div class="sbc-dots" aria-label="Carousel pagination"></div>
	{%- endif -%}
</section>

{% stylesheet %}
.shop-by-category {
	position: relative;
	padding-block: var(--sbc-pt-m) var(--sbc-pb-m);
	padding-inline: 0;
	overflow: hidden;
}

.shop-by-category .sbc-heading {
	margin: 0 0 34px;
	padding-inline: 20px;
	text-align: center;
	font-family: var(--hFontFamily);
	font-weight: 100;
	font-size: var(--sbc-heading-size-m);
	line-height: 1;            /* Figma 100% */
	letter-spacing: 0.02em;    /* Figma 2% */
	text-transform: none;      /* kills theme uppercase — Figma is "Shop by category" */
}
.shop-by-category .sbc-heading em { font-style: italic; }

/* The stage spans the full section width; the arrows anchor to it so
   both keep the same gap to the screen edge even though the viewport
   inside it has asymmetric margins (start gutter vs. edge-flush peek). */
.shop-by-category .sbc-stage { position: relative; }

.shop-by-category .sbc-viewport {
	overflow: hidden;
	margin-inline: 20px var(--sbc-pe-m, 20px);
}

/* Transform-driven track: the row always rests with a full card at the
   left content edge; sliding is translate + card rotation (infinite). */
.shop-by-category .sbc-track {
	display: flex;
	gap: var(--sbc-gap-m);
	touch-action: pan-y;
	will-change: transform;
}
.shop-by-category .sbc-track img {
	-webkit-user-drag: none;
	user-select: none;
}

/* N full cards + a fraction of the next one (the peek) fit the row.
   With no peek the formula reduces to the classic N-columns layout. */
.shop-by-category .sbc-item {
	flex: 0 0 calc((100% - (var(--sbc-cols-m) - 1 + var(--sbc-haspeek-m, 0)) * var(--sbc-gap-m)) / (var(--sbc-cols-m) + var(--sbc-peek-m, 0)));
	min-width: 0;
}

.shop-by-category .sbc-card {
	display: block;
	text-decoration: none;
	color: inherit;
}

.shop-by-category .sbc-media {
	aspect-ratio: var(--sbc-ratio);
	overflow: hidden;
	background: rgba(0, 0, 0, 0.04);
}

.shop-by-category .sbc-img {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.5s ease;
}
@media (hover: hover) {
	.shop-by-category .sbc-card:hover .sbc-img { transform: scale(1.04); }
}

.shop-by-category .sbc-label {
	display: block;
	margin-top: 14px;
	text-align: center;
	font-family: "IBM Plex Sans", var(--fontFamily), sans-serif;
	font-weight: 400;
	font-size: var(--sbc-label-size-m);
	line-height: 1.4;          /* Figma 140% */
	letter-spacing: 0;         /* Figma 0% */
}
.shop-by-category .sbc-uppercase .sbc-label { text-transform: uppercase; }

.shop-by-category .sbc-track.sbc-draggable { cursor: grab; }
.shop-by-category .sbc-track.sbc-dragging {
	cursor: grabbing;
	scroll-snap-type: none;
	user-select: none;
}
.shop-by-category .sbc-track.sbc-dragging .sbc-img { transition: none; }

/* Arrows: shown on hover only (pointer devices); hidden on touch.
   Both arrows keep the same fixed gap to the screen edge. */
.shop-by-category .sbc-arrow {
	--sbc-arrow-edge: 16px;
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
	margin: 0;
	z-index: 2;
	width: 44px;
	height: 44px;
	display: none;
	align-items: center;
	justify-content: center;
	background: #ffffff;
	color: #000000;
	border: var(--globalBorderWidth, 1px) solid #000000;
	border-radius: 50%;
	cursor: pointer;
	padding: 0;
}
.shop-by-category .sbc-prev { left: var(--sbc-arrow-edge); right: auto; }
.shop-by-category .sbc-next { right: var(--sbc-arrow-edge); left: auto; }
.shop-by-category .sbc-arrow[disabled] { opacity: 0.3 !important; pointer-events: none; }
.shop-by-category .sbc-arrow[hidden] { display: none !important; }
@media (hover: hover) {
	.shop-by-category .sbc-arrow {
		display: inline-flex;
		opacity: 0;
		transition: opacity 0.25s ease;
	}
	.shop-by-category .sbc-stage:hover .sbc-arrow,
	.shop-by-category .sbc-arrow:focus-visible { opacity: 1; }
}

/* Dots: centered cluster, 12px apart */
.shop-by-category .sbc-dots {
	display: flex;
	width: fit-content;
	justify-content: center;
	align-items: center;
	gap: 12px;
	margin: 22px auto 0;
}
.shop-by-category .sbc-dots[hidden] { display: none; }
.shop-by-category .sbc-dot {
	width: 8px;
	height: 8px;
	border-radius: 50%;
	border: var(--globalBorderWidth, 1px) solid #000000;
	background: transparent;
	padding: 0;
	cursor: pointer;
	transition: background 0.2s ease;
}
.shop-by-category .sbc-dot.is-active { background: #000000; }

@media (min-width: 778px) {
	.shop-by-category {
		padding-block: var(--sbc-pt) var(--sbc-pb);
	}
	.shop-by-category .sbc-heading {
		font-size: var(--sbc-heading-size);
		margin-bottom: 44px;
		padding-inline: 76px;
	}
	.shop-by-category .sbc-viewport {
		margin-inline: 76px var(--sbc-pe, 76px);
	}
	.shop-by-category .sbc-track {
		gap: var(--sbc-gap);
	}
	.shop-by-category .sbc-item {
		flex-basis: calc((100% - (var(--sbc-cols) - 1 + var(--sbc-haspeek, 0)) * var(--sbc-gap)) / (var(--sbc-cols) + var(--sbc-peek, 0)));
	}
	.shop-by-category .sbc-label { font-size: var(--sbc-label-size); }
}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('sbc-slider')) {
	customElements.define('sbc-slider', class extends HTMLElement {
		connectedCallback() {
			this.section = this.closest('.shop-by-category');
			this.loop = this.getAttribute('data-loop') === 'true';
			this.dotsWrap = this.section ? this.section.querySelector('.sbc-dots') : null;
			this.prevBtn = this.section ? this.section.querySelector('.sbc-prev') : null;
			this.nextBtn = this.section ? this.section.querySelector('.sbc-next') : null;
			this.offset = 0;   /* loop mode: rotation counter */
			this.pos = 0;      /* clamped mode: page index */
			this.busy = false;
			this.moved = 0;

			const refresh = () => {
				this.classList.toggle('sbc-draggable', this.overflowing());
				this.setX(this.restX(), false);
				this.buildDots();
			};
			refresh();
			new ResizeObserver(refresh).observe(this);

			if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.go(-1));
			if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.go(1));

			this.addEventListener('click', (e) => {
				if (this.moved > 6) {
					e.preventDefault();
					e.stopPropagation();
				}
				this.moved = 0;
			}, true);

			this.initDrag();
		}

		count() { return this.children.length; }

		step() {
			if (this.count() > 1) return this.children[1].offsetLeft - this.children[0].offsetLeft;
			return this.count() ? this.children[0].offsetWidth : this.clientWidth;
		}

		contentEnd() {
			if (!this.count()) return 0;
			const last = this.children[this.count() - 1];
			return last.offsetLeft + last.offsetWidth;
		}

		maxX() { return Math.max(0, this.contentEnd() - this.clientWidth); }

		overflowing() { return this.contentEnd() > this.clientWidth + 2; }

		pages() {
			if (!this.overflowing()) return 1;
			if (this.loop) return this.count();
			return Math.ceil(this.maxX() / this.step() - 0.02) + 1;
		}

		restX() { return this.loop ? 0 : -Math.min(this.pos * this.step(), this.maxX()); }

		setX(x, animate) {
			this.style.transition = animate ? 'transform 0.45s cubic-bezier(0.33, 0, 0.2, 1)' : 'none';
			this.style.transform = 'translate3d(' + x + 'px, 0, 0)';
		}

		afterSlide(fn) {
			let done = false;
			let t;
			const onEnd = (e) => { if (e.target === this && e.propertyName === 'transform') finish(); };
			const finish = () => {
				if (done) return;
				done = true;
				clearTimeout(t);
				this.removeEventListener('transitionend', onEnd);
				fn();
			};
			this.addEventListener('transitionend', onEnd);
			t = setTimeout(finish, 550);
		}

		/* Completed one-card slide forward: rotate first card to the end */
		settleNext() {
			const n = this.count();
			this.busy = true;
			this.afterSlide(() => {
				this.appendChild(this.children[0]);
				this.setX(0, false);
				this.offset = (this.offset + 1) % n;
				this.busy = false;
				this.syncUI();
			});
			this.setX(-this.step(), true);
		}

		go(dir) {
			if (this.busy || !this.overflowing()) return;
			const n = this.count();
			const step = this.step();

			if (this.loop) {
				if (dir > 0) {
					this.settleNext();
				} else {
					/* bring the last card in from the left, then slide to it */
					this.insertBefore(this.children[n - 1], this.children[0]);
					this.setX(-step, false);
					void this.offsetWidth; /* reflow: the jump must not animate */
					this.busy = true;
					this.afterSlide(() => {
						this.offset = (this.offset - 1 + n) % n;
						this.busy = false;
						this.syncUI();
					});
					this.setX(0, true);
				}
				return;
			}

			const next = Math.max(0, Math.min(this.pages() - 1, this.pos + dir));
			if (next === this.pos) return;
			this.pos = next;
			this.busy = true;
			this.afterSlide(() => { this.busy = false; this.syncUI(); });
			this.setX(this.restX(), true);
			this.syncUI();
		}

		goTo(i) {
			if (this.busy || !this.overflowing()) return;
			const n = this.count();
			if (this.loop) {
				let delta = (i - this.offset + n) % n;
				if (delta === 0) return;
				if (delta === 1) return this.go(1);
				if (delta === n - 1) return this.go(-1);
				while (delta--) this.appendChild(this.children[0]);
				this.offset = i;
				this.setX(0, false);
				this.syncUI();
			} else {
				if (i === this.pos) return;
				this.pos = Math.max(0, Math.min(this.pages() - 1, i));
				this.busy = true;
				this.afterSlide(() => { this.busy = false; this.syncUI(); });
				this.setX(this.restX(), true);
				this.syncUI();
			}
		}

		buildDots() {
			if (this.dotsWrap) {
				const pages = this.pages();
				this.dotsWrap.innerHTML = '';
				this.dotsWrap.hidden = pages <= 1;
				for (let i = 0; i < pages; i++) {
					const b = document.createElement('button');
					b.type = 'button';
					b.className = 'sbc-dot';
					b.setAttribute('aria-label', 'Go to slide ' + (i + 1));
					b.addEventListener('click', () => this.goTo(i));
					this.dotsWrap.appendChild(b);
				}
			}
			this.syncUI();
		}

		syncUI() {
			const active = this.loop ? this.offset : this.pos;
			if (this.dotsWrap) {
				this.dotsWrap.querySelectorAll('.sbc-dot').forEach((d, di) => d.classList.toggle('is-active', di === active));
			}
			const off = !this.overflowing();
			if (this.prevBtn) {
				this.prevBtn.hidden = off;
				this.prevBtn.toggleAttribute('disabled', !this.loop && this.pos <= 0);
			}
			if (this.nextBtn) {
				this.nextBtn.hidden = off;
				this.nextBtn.toggleAttribute('disabled', !this.loop && this.pos >= this.pages() - 1);
			}
		}

		initDrag() {
			let active = false;
			let preRotated = false;
			let startX = 0;
			let baseX = 0;
			let dx = 0;

			this.addEventListener('pointerdown', (e) => {
				if (this.busy || !this.overflowing()) return;
				if (e.pointerType === 'mouse') e.preventDefault(); /* stops native image drag */
				active = true;
				preRotated = false;
				this.moved = 0;
				startX = e.clientX;
				dx = 0;
				baseX = this.loop ? 0 : this.restX();
				this.setPointerCapture(e.pointerId);
				this.classList.add('sbc-dragging');
			});

			this.addEventListener('pointermove', (e) => {
				if (!active) return;
				dx = e.clientX - startX;
				this.moved = Math.max(this.moved, Math.abs(dx));
				const step = this.step();

				if (this.loop) {
					if (dx > 8 && !preRotated) {
						/* dragging toward the previous card: bring it in from the left */
						this.insertBefore(this.children[this.count() - 1], this.children[0]);
						baseX = -step;
						preRotated = true;
					}
					const x = Math.max(-step, Math.min(preRotated ? 0 : 8, baseX + dx));
					this.setX(x, false);
				} else {
					const x = Math.max(-this.maxX(), Math.min(0, baseX + dx));
					this.setX(x, false);
				}
			});

			const release = (e) => {
				if (!active) return;
				active = false;
				this.classList.remove('sbc-dragging');
				if (this.hasPointerCapture(e.pointerId)) this.releasePointerCapture(e.pointerId);

				const step = this.step();
				const th = Math.min(60, step * 0.18);
				const n = this.count();

				if (this.loop) {
					if (preRotated) {
						if (dx > th) {
							/* complete the previous-card slide */
							this.busy = true;
							this.afterSlide(() => {
								this.offset = (this.offset - 1 + n) % n;
								this.busy = false;
								this.syncUI();
							});
							this.setX(0, true);
						} else {
							/* cancel: slide back, then undo the rotation */
							this.busy = true;
							this.afterSlide(() => {
								this.appendChild(this.children[0]);
								this.setX(0, false);
								this.busy = false;
								this.syncUI();
							});
							this.setX(-step, true);
						}
					} else if (dx < -th) {
						this.settleNext();
					} else {
						this.busy = true;
						this.afterSlide(() => { this.busy = false; });
						this.setX(0, true);
					}
					return;
				}

				const x = Math.max(-this.maxX(), Math.min(0, baseX + dx));
				this.pos = Math.max(0, Math.min(this.pages() - 1, Math.round(-x / step)));
				this.busy = true;
				this.afterSlide(() => { this.busy = false; this.syncUI(); });
				this.setX(this.restX(), true);
				this.syncUI();
			};
			this.addEventListener('pointerup', release);
			this.addEventListener('pointercancel', release);
		}
	});
}
{% endjavascript %}

{% schema %}
{
	"name": "Shop by category",
	"tag": "section",
	"disabled_on": { "groups": ["header", "footer", "aside"] },
	"settings": [
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "Heading",
			"default": "Shop by <em>category</em>",
			"info": "Use italic formatting for the accent word."
		},
		{
			"type": "select",
			"id": "image_ratio",
			"label": "Image ratio",
			"default": "4 / 5",
			"options": [
				{ "value": "1 / 1", "label": "Square" },
				{ "value": "4 / 5", "label": "Portrait" },
				{ "value": "3 / 4", "label": "Tall portrait" },
				{ "value": "4 / 3", "label": "Landscape" }
			]
		},
		{
			"type": "checkbox",
			"id": "uppercase_labels",
			"label": "Uppercase labels",
			"default": true
		},
		{
			"type": "header",
			"content": "Carousel"
		},
		{
			"type": "checkbox",
			"id": "infinite_loop",
			"label": "Infinite loop",
			"info": "Arrows wrap around from the last card back to the first.",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"label": "Show arrows",
			"info": "Arrows appear on hover (desktop only).",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_dots",
			"label": "Show dots",
			"default": true
		},
		{
			"type": "header",
			"content": "Desktop"
		},
		{
			"type": "range",
			"id": "columns_desktop",
			"label": "Visible collections",
			"min": 2,
			"max": 6,
			"step": 1,
			"default": 5,
			"info": "Add more blocks than this to enable the carousel."
		},
		{
			"type": "range",
			"id": "peek",
			"label": "Next card preview",
			"info": "How much of the next card shows at the right edge. Applies only when there are more cards than visible.",
			"min": 0,
			"max": 40,
			"step": 5,
			"default": 20,
			"unit": "%"
		},
		{
			"type": "range",
			"id": "gap_desktop",
			"label": "Gap between cards",
			"min": 4,
			"max": 60,
			"step": 2,
			"default": 24,
			"unit": "px"
		},
		{
			"type": "range",
			"id": "heading_size",
			"label": "Heading size",
			"min": 20,
			"max": 80,
			"step": 2,
			"default": 48,
			"unit": "px"
		},
		{
			"type": "range",
			"id": "label_size",
			"label": "Label size",
			"min": 10,
			"max": 24,
			"step": 1,
			"default": 13,
			"unit": "px"
		},
		{
